# 服务
PORT=4311
APP_BASE_URL=http://127.0.0.1:4311
DATABASE_PATH=./data/workbench.sqlite
LOG_DIR=./logs
OUTPUT_DIR=./output

# 合规数据源：demo（内置演示）或 rss（仅抓取你配置的公开/授权 RSS）
DATA_SOURCE_MODE=demo
PUBLIC_RSS_FEEDS=
HTTP_TIMEOUT_MS=10000
HTTP_MAX_RETRIES=3

# 图片：codex_manual 只生成任务包，等待当前 Codex 会员内置 image_gen/Image2 回填
# 严禁填写 API Key；应用不会调用第三方付费图片接口
IMAGE_PROVIDER_MODE=codex_manual
IMAGE_INBOX_DIR=./data/image-inbox

# 微信：mock（默认，无凭证可验收）或 real（只创建草稿，不发布）
WECHAT_MODE=mock
WECHAT_APP_ID=
WECHAT_APP_SECRET=
