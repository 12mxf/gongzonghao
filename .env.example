# 服务
PORT=4311
APP_BASE_URL=http://127.0.0.1:4311
DATABASE_PATH=./data/workbench.sqlite
LOG_DIR=./logs
OUTPUT_DIR=./output

# 合规数据源：demo、rss，或 tikhub（搜狗公开发现 + TikHub 官方数据补全，会产生 TikHub 费用）
DATA_SOURCE_MODE=demo
PUBLIC_RSS_FEEDS=
DATA_PROVIDER_KEY=
# 中国大陆使用 .dev；其他地区可改为 https://api.tikhub.io
TIKHUB_BASE_URL=https://api.tikhub.dev
# 可选：已知的公众号文章直链，使用 V2 接口补全详情和指标；多个 URL 用逗号分隔
TIKHUB_SEED_URLS=
SEARCH_RESULT_LIMIT=20
SOGOU_MAX_PAGES=3
HTTP_TIMEOUT_MS=10000
HTTP_MAX_RETRIES=3

# 图片：codex_manual 只生成任务包，等待当前 Codex 会员内置 image_gen/Image2 回填
# 严禁填写 API Key；应用不会调用第三方付费图片接口
IMAGE_PROVIDER_MODE=codex_manual
IMAGE_INBOX_DIR=./data/image-inbox

# 微信：mock（默认，无凭证可验收）或 real（只创建草稿，不发布）
WECHAT_MODE=mock
WECHAT_APP_ID=
WECHAT_APP_SECRET=
